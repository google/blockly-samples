{
  "name": "blockly-samples",
  "version": "0.0.0",
  "description": "Samples for using Blockly",
  "author": "Blockly Team",
  "license": "Apache-2.0",
  "scripts": {
    "deploy:prepare": "npm run deploy:prepare:examples && gulp predeploy",
    "deploy:prepare:examples": "npm install --workspace=examples && npm run prepare-examples && npm run predeploy --if-present --workspace=examples",
    "deploy": "npm run deploy:prepare && gulp deploy",
    "deploy:upstream": "npm run deploy:prepare && gulp deployUpstream",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:ghpages:beta": "gulp testGhPagesBeta",
    "test:ghpages": "gulp testGhPages",
    "prepare-examples": "node ./scripts/copy-blockly.js"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "blockly": "^13.2.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.5.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-header": "^2.0.12",
    "http-server": "^14.1.1",
    "lerna": "^10.1.1",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "showdown": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "examples/blockly-**",
    "examples/**-demo",
    "examples/sample-**",
    "examples/developer-tools"
  ]
}
